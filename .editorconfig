root = true

# All files
[*]
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# C# files
[*.{cs}]
indent_style = space
indent_size = 4
csharp_indent_block_contents = true
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_space_after_cast = true
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_parentheses = false
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_around_binary_operators = before_and_after
csharp_prefer_braces = true
# Prefer target-typed 'new()' where the type is obvious
# e.g.: process = new() { StartInfo = startInfo };
# instead of: process = new Process() { StartInfo = startInfo };
# Roslyn rule (Visual Studio / IDE0090)
csharp_style_implicit_object_creation_when_type_is_apparent = true:suggestion

# ReSharper / Rider engine — used by "Reformat and Cleanup"
resharper_csharp_object_creation_when_type_evident = target_typed
# Use target-typed 'new()' even when the type is not evident from the statement,
# e.g. on assignments to an existing variable: process = new() { StartInfo = startInfo };
resharper_csharp_object_creation_when_type_not_evident = target_typed
resharper_csharp_use_roslyn_logic_for_evident_types = true

# Prefer explicit types instead of var (Microsoft style)
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = false:suggestion
csharp_style_var_elsewhere = false:suggestion

# Prefer explicit types instead of var (ReSharper / Rider style)
resharper_csharp_for_built_in_types = use_explicit_type
resharper_csharp_for_simple_types = use_explicit_type
resharper_csharp_for_other_types = use_explicit_type

# Naming rule: constants should be UPPER_CASE
dotnet_naming_rule.constants_uppercase.symbols = constants
dotnet_naming_rule.constants_uppercase.style = uppercase_style
dotnet_naming_rule.constants_uppercase.severity = warning

# Symbol group: constants (includes local constants)
dotnet_naming_symbols.constants.applicable_kinds = field, local
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_symbols.constants.applicable_accessibilities = *

# Naming style: UPPER_CASE
dotnet_naming_style.uppercase_style.capitalization = all_upper
dotnet_naming_style.uppercase_style.word_separator = _

# Sort using directives, placing system directives first
dotnet_sort_system_directives_first = true

# Preferred modifier order
dotnet_style_readonly_field = true:suggestion
csharp_preferred_modifier_order = public, private, protected, internal, file, static, extern, new, virtual, abstract, sealed, override, readonly, unsafe, required, volatile, async:suggestion

# dotnet code style
dotnet_style_qualification_for_field = false
dotnet_style_qualification_for_property = false
dotnet_style_qualification_for_method = false
dotnet_style_qualification_for_event = false

# Naming conventions
dotnet_naming_rule.public_members_must_be_pascal_case.severity = suggestion
dotnet_naming_rule.public_members_must_be_pascal_case.symbols = public_symbols
dotnet_naming_rule.public_members_must_be_pascal_case.style = pascal_case_style

dotnet_naming_symbols.public_symbols.applicable_kinds = property, method, field, event, delegate
dotnet_naming_symbols.public_symbols.applicable_accessibilities = public

dotnet_naming_style.pascal_case_style.capitalization = pascal_case

# Async methods must end with "Async"
dotnet_naming_rule.async_methods_must_end_with_async.severity = warning
dotnet_naming_rule.async_methods_must_end_with_async.symbols = async_methods
dotnet_naming_rule.async_methods_must_end_with_async.style = async_suffix_style

dotnet_naming_symbols.async_methods.applicable_kinds = method
dotnet_naming_symbols.async_methods.required_modifiers = async

dotnet_naming_style.async_suffix_style.capitalization = pascal_case
dotnet_naming_style.async_suffix_style.required_suffix = Async

# Blank lines
csharp_blank_lines_around_property = 1
csharp_blank_lines_around_auto_property = 1
csharp_blank_lines_around_single_line_property = 1
csharp_blank_lines_around_single_line_auto_property = 1
resharper_csharp_blank_lines_around_property = 1
resharper_csharp_blank_lines_around_auto_property = 1
resharper_csharp_blank_lines_around_single_line_property = 1
resharper_csharp_blank_lines_around_single_line_auto_property = 1
resharper_csharp_keep_blank_lines_between_declarations = 1

# Json and YML
[*.{json,yaml,yml}]
indent_style = space
indent_size = 2

# Docs
[*.md]
trim_trailing_whitespace = false