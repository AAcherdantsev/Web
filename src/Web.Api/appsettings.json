{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DataSource": "Mock",
  "Database": {
    "MigrateOnStartup": true,
    "SeedSampleData": true
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 65536
    }
  },
  "Pagination": {
    "DefaultPageSize": 10,
    "MaxPageSize": 100
  },
  "RateLimiting": {
    "Reads": {
      "TokenLimit": 100,
      "TokensPerPeriod": 100,
      "ReplenishmentPeriodSeconds": 60
    },
    "Writes": {
      "TokenLimit": 20,
      "TokensPerPeriod": 20,
      "ReplenishmentPeriodSeconds": 60
    }
  }
}
